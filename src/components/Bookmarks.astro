---
// Bookmarks component.
//
// The markup below renders during the static build. All dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// runs ONLY in the client-side <script> boundary at the bottom of this file.
// Astro runs that script in the browser, never during the build, so
// browser-only APIs (localStorage, clipboard) are safe there. The pure
// helpers it relies on live in ../lib/bookmarks so they can be unit tested
// without a browser.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only. Astro bundles this
  // module and never executes it during the static build, so localStorage
  // and clipboard access below are safe.
  import type { Bookmark } from '../lib/bookmarks';
  import {
    formatBookmark,
    generateSlug,
    normalizeUrl,
    parseBookmarks,
    serializeBookmarks,
    STORAGE_KEY,
  } from '../lib/bookmarks';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const urlInput = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAllButton = document.getElementById('clear-all');

  /** Reads bookmarks from localStorage, defensively. Never throws. */
  function loadBookmarks(): Bookmark[] {
    try {
      return parseBookmarks(localStorage.getItem(STORAGE_KEY));
    } catch {
      // Storage inaccessible (private mode, quota, etc.) — treat as empty.
      return [];
    }
  }

  function saveBookmarks(bookmarks: Bookmark[]): void {
    try {
      localStorage.setItem(STORAGE_KEY, serializeBookmarks(bookmarks));
    } catch {
      // Ignore storage write failures rather than throwing.
    }
  }

  function renderBookmark(bookmark: Bookmark): HTMLLIElement {
    const item = document.createElement('li');
    item.className = 'bookmark';

    const link = document.createElement('a');
    link.className = 'url';
    link.href = bookmark.url;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = bookmark.url;

    const slugBadge = document.createElement('span');
    slugBadge.className = 'slug';
    slugBadge.textContent = bookmark.slug;
    slugBadge.title = formatBookmark(bookmark);

    const separator = document.createElement('span');
    separator.className = 'separator';
    separator.textContent = ' :: ';

    const copyButton = document.createElement('button');
    copyButton.type = 'button';
    copyButton.className = 'copy';
    copyButton.textContent = 'Copy';
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(bookmark.slug);
        const original = copyButton.textContent;
        copyButton.textContent = 'Copied!';
        setTimeout(() => {
          copyButton.textContent = original ?? 'Copy';
        }, 1200);
      } catch {
        // Clipboard access can fail (permissions, insecure context); ignore.
      }
    });

    item.append(link, separator, slugBadge, copyButton);
    return item;
  }

  function render(bookmarks: Bookmark[]): void {
    if (!list || !emptyState || !listHeader) return;

    list.replaceChildren(...bookmarks.map(renderBookmark));

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // keep this — stops the page from reloading
    if (!urlInput) return;

    const normalized = normalizeUrl(urlInput.value);
    if (!normalized) return;

    const bookmarks = loadBookmarks();

    const existing = bookmarks.find((bookmark) => bookmark.url === normalized);
    if (!existing) {
      const slug = generateSlug(new Set(bookmarks.map((bookmark) => bookmark.slug)));
      bookmarks.push({ url: normalized, slug });
      saveBookmarks(bookmarks);
    }

    render(bookmarks);
    form.reset();
    urlInput.focus();
  });

  clearAllButton?.addEventListener('click', () => {
    if (!confirm('Remove all saved bookmarks?')) return;
    saveBookmarks([]);
    render([]);
  });

  // Initial render on page load so bookmarks survive a reload.
  render(loadBookmarks());
</script>
